#!/usr/bin/env python3
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(
        "llm-hud requires Python 3.11 or newer; this is Python %d.%d.\n"
        "Hint: re-run install.sh, or set LLM_HUD_PYTHON=/path/to/python3.11 first.\n"
        % sys.version_info[:2]
    )
    raise SystemExit(1)

from pathlib import Path

SOURCE = Path(__file__).resolve().parents[1] / "src"
if str(SOURCE) not in sys.path:
    sys.path.insert(0, str(SOURCE))

from llm_hud.cli import main


if __name__ == "__main__":
    raise SystemExit(main())

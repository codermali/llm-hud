#!/usr/bin/env python3
"""Stable llm-hud entry point installed as INSTALL_ROOT/bin/llm-hud.

Keep this file deliberately small.  It verifies the stable control file before
loading it, then the control layer validates and dispatches the active runtime.
The installer invokes this script with its pinned Python interpreter, while the
shebang keeps direct execution useful on systems whose python3 is new enough.
"""

from __future__ import annotations

import os
import stat
import sys
from pathlib import Path
from types import ModuleType


INSTALL_MARKER = ".llm-hud-install-root"
INSTALL_MARKER_VALUE = "llm-hud-install-root-v1\n"
LAYOUT_MARKER = ".llm-hud-layout"
LAYOUT_MARKER_VALUE = "llm-hud-versioned-layout-v1\n"
CONTROL_RELATIVE = Path("control") / "runtime_control.py"
MAX_STABLE_FILE_SIZE = 64 * 1024


class DispatcherError(ValueError):
    """The stable dispatcher or control layer is not safe to use."""


def _require_directory(path: Path, description: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise DispatcherError(f"cannot inspect {description} {path}: {error}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise DispatcherError(f"{description} is not a regular directory: {path}")


def _read_owned_text(path: Path, description: str) -> str:
    try:
        before = path.lstat()
    except OSError as error:
        raise DispatcherError(f"cannot inspect {description} {path}: {error}") from error
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
        raise DispatcherError(f"{description} is not a regular managed file: {path}")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = -1
    try:
        descriptor = os.open(path, flags)
        chunks: list[bytes] = []
        remaining = MAX_STABLE_FILE_SIZE + 1
        while remaining:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        if len(payload) > MAX_STABLE_FILE_SIZE:
            raise DispatcherError(f"{description} is too large: {path}")
        return payload.decode("utf-8")
    except (OSError, UnicodeError) as error:
        raise DispatcherError(f"cannot read {description} {path}: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _require_regular_file(path: Path, description: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise DispatcherError(f"cannot inspect {description} {path}: {error}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise DispatcherError(f"{description} is not a regular managed file: {path}")


def _load_control(path: Path, source: str) -> ModuleType:
    name = "_llm_hud_stable_runtime_control"
    module = ModuleType(name)
    module.__file__ = str(path)
    module.__package__ = ""
    sys.modules[name] = module
    try:
        code = compile(source, str(path), "exec", dont_inherit=True)
        exec(code, module.__dict__)
    except Exception:
        sys.modules.pop(name, None)
        raise
    return module


def main() -> int:
    if sys.version_info < (3, 11):
        raise DispatcherError(
            "llm-hud requires Python 3.11 or newer; re-run install.sh with "
            "LLM_HUD_PYTHON set to a supported interpreter"
        )
    dispatcher = Path(os.path.abspath(__file__))
    root = dispatcher.parent.parent
    expected_dispatcher = root / "bin" / "llm-hud"
    if dispatcher != expected_dispatcher:
        raise DispatcherError(
            f"stable dispatcher is not installed at {expected_dispatcher}"
        )
    _require_directory(root, "install root")
    _require_directory(root / "bin", "stable bin directory")
    _require_regular_file(dispatcher, "stable dispatcher")
    if _read_owned_text(root / INSTALL_MARKER, "install marker") != INSTALL_MARKER_VALUE:
        raise DispatcherError(f"install root is not owned by llm-hud: {root}")
    if _read_owned_text(root / LAYOUT_MARKER, "layout marker") != LAYOUT_MARKER_VALUE:
        raise DispatcherError(f"missing or unrecognized runtime layout in {root}")
    _require_directory(root / "control", "stable control directory")
    control_path = root / CONTROL_RELATIVE
    control_source = _read_owned_text(control_path, "stable runtime control")

    control = _load_control(control_path, control_source)
    if not hasattr(control, "run") or not hasattr(control, "ControlError"):
        raise DispatcherError(f"stable runtime control has no supported interface: {control_path}")
    try:
        return int(control.run(root, sys.argv[1:]))
    except control.ControlError as error:
        print(f"llm-hud: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DispatcherError as error:
        print(f"llm-hud: {error}", file=sys.stderr)
        raise SystemExit(1)

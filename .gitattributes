# Runtime payloads are digested byte-for-byte and the managed text readers
# run in CRT text mode on Windows; keep every checkout LF so source installs
# hash identically on all platforms.
* text=auto eol=lf

# Release installation archives need only the runtime sources and bootstrap
# files. Keep repository-only development material out of `git archive` while
# retaining it in normal checkouts.
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/CONTRIBUTING.md export-ignore
/MANIFEST.in export-ignore
/docs export-ignore
/install.sh export-ignore
/scripts/bench_render.py export-ignore
/scripts/verify_distribution.py export-ignore
/tests export-ignore
